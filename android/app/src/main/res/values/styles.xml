<resources>
    <style name="Theme.CricVault" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#91E521</item>
        <item name="android:navigationBarColor">#020A0F</item>
        <item name="android:statusBarColor">#020A0F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="CricVaultSecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/entry_button_secondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#F5F7F4</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
