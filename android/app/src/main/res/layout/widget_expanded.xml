<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/widget_brand" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CV  CRICVAULT · LIVE MATCH" android:textColor="@color/widget_text" android:textSize="11sp" android:textStyle="bold" /><TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SYNCING" android:textColor="@color/widget_lime" android:textSize="10sp" android:textStyle="bold" /></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:id="@+id/widget_batting_logo" android:layout_width="50dp" android:layout_height="50dp" android:adjustViewBounds="true" android:contentDescription="Batting team logo" android:scaleType="centerInside" /><TextView android:id="@+id/widget_batting" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="WAITING" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/widget_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0" android:textColor="@color/widget_text" android:textSize="52sp" android:textStyle="bold" /><TextView android:id="@+id/widget_overs" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 OVERS" android:textColor="@color/widget_muted" android:textSize="11sp" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><ImageView android:id="@+id/widget_bowling_logo" android:layout_width="50dp" android:layout_height="50dp" android:adjustViewBounds="true" android:contentDescription="Bowling team logo" android:scaleType="centerInside" /><TextView android:id="@+id/widget_bowling" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text="DPL 6" android:textColor="@color/widget_text" android:textSize="13sp" android:textStyle="bold" /></LinearLayout></LinearLayout>
    <TextView android:id="@+id/widget_context" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_panel" android:gravity="center" android:padding="8dp" android:text="INNINGS 1" android:textColor="@color/widget_lime" android:textSize="12sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:paddingBottom="10dp"><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/widget_striker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STRIKER" android:textColor="@color/widget_lime" android:textSize="10sp" /><TextView android:id="@+id/widget_striker_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0* (0)" android:textColor="@color/widget_text" android:textSize="19sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/widget_non_striker" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NON-STRIKER" android:textColor="@color/widget_muted" android:textSize="10sp" /><TextView android:id="@+id/widget_non_striker_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 (0)" android:textColor="@color/widget_text" android:textSize="19sp" android:textStyle="bold" /></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:orientation="vertical"><TextView android:id="@+id/widget_bowler" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BOWLER" android:textColor="@color/widget_muted" android:textSize="10sp" /><TextView android:id="@+id/widget_bowler_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/0 (0.0)" android:textColor="@color/widget_text" android:textSize="19sp" android:textStyle="bold" /></LinearLayout></LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/widget_panel" android:gravity="center_vertical" android:padding="10dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST 6 BALLS   " android:textColor="@color/widget_muted" android:textSize="9sp" /><TextView android:id="@+id/widget_balls" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="WAITING FOR FIRST BALL" android:textColor="@color/widget_text" android:textSize="11sp" android:textStyle="bold" /></LinearLayout>
</LinearLayout>
